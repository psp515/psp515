---
import type { Lang } from "../data/types";
import { projects } from "../data/projects";
import { projectsHead } from "../data/profile";
import ProjectEntry from "./ProjectEntry.astro";
import Reveal from "./Reveal.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

let lastYear: number | null = null;
let step = 0;
---

<div class="page-head sec-head">
  <h2>{projectsHead.title[lang]}</h2>
  <p>{projectsHead.sub[lang]}</p>
</div>

<div class="spine proj">
  {projects.map((p) => {
    const showYear = p.year !== lastYear;
    lastYear = p.year;
    const yearDelay = showYear ? (step++ % 3) * 70 : 0;
    const entryDelay = (step++ % 3) * 70;
    return (
      <>
        {showYear && (
          <div class:list={["ymark", { "is-now": p.isNow }]} data-reveal style={`--d:${yearDelay}ms`}>
            <span>{p.year}</span>
          </div>
        )}
        <ProjectEntry project={p} lang={lang} delay={entryDelay} />
      </>
    );
  })}
</div>

<Reveal />
