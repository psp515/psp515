---
import type { Lang } from "../data/types";
import { pages, strings } from "../data/nav";
import { ui } from "../data/icons";
import { withBase } from "../lib/paths";

interface Props {
  lang: Lang;
  current: string;
}

const { lang, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = pages.find((p) => p.slug === current)?.path ?? "";
---

<nav class="nav">
  <div class="nav-in">
    <a class="mark" href={withBase(base, lang, "")}>{strings.mark}</a>
    <div class="nav-links">
      {pages.map((p) => (
        <a
          href={withBase(base, lang, p.path)}
          aria-current={p.slug === current ? "page" : "false"}
        >
          {p.label[lang]}
        </a>
      ))}
    </div>
    <div class="langs" role="group" aria-label="Language">
      <a href={withBase(base, "en", currentPath)} aria-current={String(lang === "en")}>EN</a>
      <a href={withBase(base, "pl", currentPath)} aria-current={String(lang === "pl")}>PL</a>
    </div>
    <button class="theme" type="button" aria-label={lang === "pl" ? "Zmień motyw" : "Switch theme"}>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true" set:html={ui.sun} />
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true" set:html={ui.moon} />
    </button>
  </div>
</nav>

<script is:inline>
  document.querySelector(".theme")?.addEventListener("click", () => {
    const root = document.documentElement;
    // computed color-scheme covers all three states: stored pick, OS preference, default dark
    const next = getComputedStyle(root).colorScheme.includes("dark") ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("psp515-theme", next);
    } catch (e) {}
  });
</script>
