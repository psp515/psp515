---
import { backdrop } from "../data/icons";
---
<div class="backdrop" aria-hidden="true">
  <div class="glyph g-bike"><svg viewBox={backdrop.bike.viewBox} set:html={backdrop.bike.body} /></div>
  <div class="glyph g-print"><svg viewBox={backdrop.print.viewBox} set:html={backdrop.print.body} /></div>
  <div class="glyph g-ball"><svg viewBox={backdrop.ball.viewBox} set:html={backdrop.ball.body} /></div>
  <div class="glyph g-asg"><svg viewBox={backdrop.asg.viewBox} set:html={backdrop.asg.body} /></div>
  <div class="glyph g-led"><svg viewBox={backdrop.led.viewBox} set:html={backdrop.led.body} /></div>
  <div class="glyph g-chip"><svg viewBox={backdrop.chip.viewBox} set:html={backdrop.chip.body} /></div>
  <div class="glyph g-chip2"><svg viewBox={backdrop.chip.viewBox} set:html={backdrop.chip.body} /></div>
  <div class="glyph g-led2"><svg viewBox={backdrop.led.viewBox} set:html={backdrop.led.body} /></div>
  <div class="glyph g-asg2"><svg viewBox={backdrop.asg.viewBox} set:html={backdrop.asg.body} /></div>
  <div class="glyph g-ball2"><svg viewBox={backdrop.ball.viewBox} set:html={backdrop.ball.body} /></div>
  <div class="glyph g-print2"><svg viewBox={backdrop.print.viewBox} set:html={backdrop.print.body} /></div>
  <div class="glyph g-bike2"><svg viewBox={backdrop.bike.viewBox} set:html={backdrop.bike.body} /></div>
</div>
